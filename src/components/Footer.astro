---
import Icon from './Icon.astro';
import { getSiteConfig } from '../data/site';

const today = new Date();
const { profile, site } = await getSiteConfig();
---

<footer>
  &copy; {today.getFullYear()}
  {site.title}. {site.footerNote}
  <div class="social-links">
    <a href={profile.website} target="_blank" rel="noreferrer">
      <span class="sr-only">Open website</span>
      <Icon name="compass" size={18} />
    </a>
    <a href={profile.github} target="_blank" rel="noreferrer">
      <span class="sr-only">Open GitHub profile</span>
      <Icon name="github" size={18} />
    </a>
    {
      profile.threads && (
        <a href={profile.threads} target="_blank" rel="noreferrer">
          <span class="sr-only">Open Threads profile</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M12.19 24h-.01c-3.58-.02-6.33-1.2-8.18-3.51C2.35 18.44 1.5 15.59 1.47 12.01v-.02C1.5 8.41 2.35 5.56 4 3.51 5.85 1.2 8.6.02 12.18 0h.02c2.75.02 5.04.73 6.83 2.1 1.68 1.29 2.86 3.13 3.51 5.47l-2.04.57c-1.1-3.96-3.9-5.99-8.3-6.02-2.91.02-5.11.94-6.54 2.72C4.31 6.5 3.62 8.91 3.59 12c.03 3.09.72 5.5 2.06 7.16 1.43 1.78 3.63 2.7 6.54 2.72 2.62-.02 4.36-.63 5.8-2.04 1.65-1.61 1.62-3.59 1.08-4.75-.32-.68-.89-1.22-1.65-1.6-.19 1.35-.62 2.45-1.28 3.27-.89 1.1-2.14 1.7-3.73 1.79-1.2.07-2.36-.22-3.26-.8-1.06-.69-1.69-1.74-1.75-2.96-.13-2.38 1.75-4.08 4.69-4.23 1.05-.05 2.04 0 2.94.14-.12-.73-.36-1.3-.73-1.71-.54-.59-1.35-.9-2.41-.91h-.03c-.86 0-2.03.24-2.77 1.36L7.3 8.25C8.28 6.8 9.87 6 11.78 6h.04c3.19.05 5.17 2.07 5.42 5.54 1.51.57 2.62 1.52 3.17 2.69.85 1.82.93 4.78-1.51 7.17C17.78 23.16 15.46 23.98 12.19 24zm0-11.34c-.33 0-.67.01-1.01.03-1.68.08-2.63.82-2.59 1.99.05 1 1.08 1.72 2.45 1.72h.2c1.84-.1 2.96-1.21 3.33-3.29-.69-.29-1.5-.45-2.38-.45z" />
          </svg>
        </a>
      )
    }
    <a href={`mailto:${profile.email}`}>
      <span class="sr-only">Email</span>
      <Icon name="mail" size={18} />
    </a>
  </div>
</footer>
<style>
  footer {
    padding: 3em 1em 6em;
    color: var(--paper-ink-faint);
    font-size: 0.88rem;
    text-align: center;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 1em;
    margin-top: 1em;
  }
  .social-links a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    text-decoration: none;
    color: var(--paper-ink-soft);
  }
  .social-links a:hover {
    color: var(--paper-accent);
  }
</style>
