---
import BaseHead from '../components/BaseHead.astro';
import { Github, Linkedin } from 'lucide-astro';
import { getThemePalette, getSiteConfig } from '../data/site';

const { profile } = await getSiteConfig();
const palette = await getThemePalette();

const pageTitle = `${profile.name} | Bio`;
const pageDescription = `${profile.name} — ${profile.role}. Links, projects, and contact.`;

const links = [
  { label: 'Website', href: profile.website, desc: profile.website.replace('https://', '') },
  { label: 'GitHub', href: profile.github, desc: profile.github.replace('https://', '') },
  { label: 'Blog', href: '/blog', desc: 'Essays, notes, and field reports' },
  { label: 'Projects', href: '/projects', desc: 'Selected work and project notes' },
  { label: 'Tools', href: '/tools', desc: 'Curated tools I use, with honest reviews' },
  { label: 'About', href: '/about', desc: 'Profile and background' },
  { label: 'Email', href: `mailto:${profile.email}`, desc: profile.email },
];

const socials = [
  { label: 'GitHub', href: profile.github, icon: 'github' },
  { label: 'Threads', href: 'https://www.threads.com/@novski.dev', icon: 'threads' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/novskidev', icon: 'linkedin' },
];
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body class="bio-page">
    <main class="bio-main" data-pagefind-body>
      <header class="bio-header">
        <img src={profile.avatar} alt={profile.name} width="96" height="96" loading="eager" />
        <h1>{profile.name}</h1>
        <p class="bio-role">{profile.role}</p>
        <p class="bio-location">{profile.location}</p>
      </header>

      <nav class="bio-links" aria-label="Bio links">
        {
          links.map((link) => (
            <a
              class="bio-link"
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span class="bio-link-text">
                <span class="bio-link-label">{link.label}</span>
                <span class="bio-link-desc">{link.desc}</span>
              </span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H8M17 7v9" />
              </svg>
            </a>
          ))
        }
      </nav>

      <div class="bio-socials">
        {
          socials.map((social) => (
            <a
              class="bio-social"
              href={social.href}
              target="_blank"
              rel="noreferrer"
              aria-label={social.label}
            >
              {social.icon === 'github' && <Github size={20} />}
              {social.icon === 'linkedin' && <Linkedin size={20} />}
              {social.icon === 'threads' && (
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12.19 24h-.01c-3.58-.02-6.33-1.2-8.18-3.51C2.35 18.44 1.5 15.59 1.47 12.01v-.02C1.5 8.41 2.35 5.56 4 3.51 5.85 1.2 8.6.02 12.18 0h.02c2.75.02 5.04.73 6.83 2.1 1.68 1.29 2.86 3.13 3.51 5.47l-2.04.57c-1.1-3.96-3.9-5.99-8.3-6.02-2.91.02-5.11.94-6.54 2.72C4.31 6.5 3.62 8.91 3.59 12c.03 3.09.72 5.5 2.06 7.16 1.43 1.78 3.63 2.7 6.54 2.72 2.62-.02 4.36-.63 5.8-2.04 1.65-1.61 1.62-3.59 1.08-4.75-.32-.68-.89-1.22-1.65-1.6-.19 1.35-.62 2.45-1.28 3.27-.89 1.1-2.14 1.7-3.73 1.79-1.2.07-2.36-.22-3.26-.8-1.06-.69-1.69-1.74-1.75-2.96-.13-2.38 1.75-4.08 4.69-4.23 1.05-.05 2.04 0 2.94.14-.12-.73-.36-1.3-.73-1.71-.54-.59-1.35-.9-2.41-.91h-.03c-.86 0-2.03.24-2.77 1.36L7.3 8.25C8.28 6.8 9.87 6 11.78 6h.04c3.19.05 5.17 2.07 5.42 5.54 1.51.57 2.62 1.52 3.17 2.69.85 1.82.93 4.78-1.51 7.17C17.78 23.16 15.46 23.98 12.19 24zm0-11.34c-.33 0-.67.01-1.01.03-1.68.08-2.63.82-2.59 1.99.05 1 1.08 1.72 2.45 1.72h.2c1.84-.1 2.96-1.21 3.33-3.29-.69-.29-1.5-.45-2.38-.45z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </main>
  </body>
</html>

<style>
  .bio-page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-bg);
    color: var(--paper-ink);
    padding: max(40px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right))
      max(40px, env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left));
  }

  .bio-main {
    width: min(100%, 480px);
  }

  .bio-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 28px;
  }

  .bio-header img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 14px;
    border: 2px solid var(--paper-line);
  }

  .bio-header h1 {
    margin: 0;
    color: var(--paper-ink);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .bio-role {
    margin: 6px 0 0;
    color: var(--paper-ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .bio-location {
    margin: 2px 0 0;
    color: var(--paper-ink-faint);
    font-size: 0.85rem;
  }

  .bio-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bio-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border: 1px solid var(--paper-line);
    min-height: 52px;
    border-radius: 12px;
    background: var(--paper-surface);
    color: var(--paper-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .bio-link:focus-visible,
  .bio-social:focus-visible {
    outline: 2px solid var(--paper-accent);
    outline-offset: 2px;
  }

  .bio-link:active {
    background: var(--paper-control);
    transform: scale(0.99);
  }

  .bio-link-text {
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: baseline;
    gap: 12px;
  }

  .bio-link-label {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .bio-link-desc {
    flex: 1;
    color: var(--paper-ink-faint);
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bio-link svg {
    flex: 0 0 auto;
    color: var(--paper-ink-faint);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  @media (hover: hover) {
    .bio-link:hover {
      border-color: var(--paper-ink);
      background: var(--paper-control);
      transform: translateY(-1px);
    }

    .bio-link:hover svg {
      color: var(--paper-accent);
      transform: translateX(2px) translateY(-2px);
    }

    .bio-social:hover {
      color: var(--paper-accent);
      background: var(--paper-control);
    }
  }

  .bio-socials {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }

  .bio-social {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--paper-ink-soft);
    text-decoration: none;
    transition:
      color 180ms ease,
      background 180ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-link,
    .bio-link svg,
    .bio-social {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .bio-page {
      align-items: flex-start;
      padding-top: max(48px, env(safe-area-inset-top));
      padding-right: max(16px, env(safe-area-inset-right));
      padding-left: max(16px, env(safe-area-inset-left));
    }

    .bio-header img {
      width: 88px;
      height: 88px;
    }

    .bio-header h1 {
      font-size: 1.375rem;
    }

    .bio-links {
      gap: 10px;
    }

    .bio-link {
      min-height: 60px;
      padding: 12px 16px;
    }

    .bio-link-text {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .bio-link-desc {
      width: 100%;
      overflow-wrap: anywhere;
      white-space: normal;
    }

    .bio-socials {
      gap: 12px;
      margin-top: 28px;
    }

    .bio-social {
      width: 48px;
      height: 48px;
    }
  }
</style>
