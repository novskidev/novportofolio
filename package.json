{
  "name": "novskidev",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "content:check": "bun scripts/validate-content.ts",
    "build": "bun scripts/validate-content.ts && astro build && pagefind --site dist --output-subdir pagefind --root-selector main --exclude-selectors \"[data-pagefind-ignore]\" --force-language en",
    "preview": "astro preview",
    "astro": "astro",
    "post:new": "bun scripts/new-content.ts blog",
    "project:new": "bun scripts/new-content.ts project",
    "vibe:new": "bun scripts/new-content.ts vibe",
    "lint": "eslint .",
    "css:check": "grep -rh '@media' src | grep -o '[0-9]*px' | grep -vE '^(640|720|721|900|901|1180|1181)px$' && echo 'Unknown breakpoint above. Allowed: 640/720/900/1180' && exit 1 || exit 0",
    "format": "prettier --write .",
    "format:check": "bun run lint && bun run css:check && prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@expressive-code/plugin-collapsible-sections": "^0.42.0",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@fontsource/maple-mono": "^5.2.6",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.5",
    "astro-expressive-code": "^0.42.0",
    "lucide-astro": "^0.556.0",
    "sharp": "^0.34.5",
    "smol-toml": "^1.6.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.60.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": "bun run format:check"
  }
}
