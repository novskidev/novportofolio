---
import BaseHead from '../components/BaseHead.astro';
import { Github, Linkedin } from 'lucide-astro';
import { getThemePalette, getSiteConfig } from '../data/site';

const { profile } = await getSiteConfig();
const palette = await getThemePalette();

const pageTitle = `${profile.name} | Bio`;
const pageDescription = `${profile.name} — ${profile.role}. Links, projects, and contact.`;

const links = [
  { label: 'Website', href: profile.website, desc: profile.website.replace('https://', '') },
  { label: 'GitHub', href: profile.github, desc: profile.github.replace('https://', '') },
  { label: 'Blog', href: '/blog', desc: 'Essays, notes, and field reports' },
  { label: 'Projects', href: '/projects', desc: 'Selected work and project notes' },
  { label: 'About', href: '/about', desc: 'Profile and background' },
  { label: 'Email', href: `mailto:${profile.email}`, desc: profile.email },
];

const socials = [
  { label: 'GitHub', href: profile.github, icon: 'github' },
  { label: 'Threads', href: 'https://threads.net/@novskidev', icon: 'threads' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/novskidev', icon: 'linkedin' },
];
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body class="bio-page">
    <main class="bio-main" data-pagefind-body>
      <header class="bio-header">
        <img src={profile.avatar} alt={profile.name} width="96" height="96" loading="eager" />
        <h1>{profile.name}</h1>
        <p class="bio-role">{profile.role}</p>
        <p class="bio-location">{profile.location}</p>
      </header>

      <nav class="bio-links" aria-label="Bio links">
        {
          links.map((link) => (
            <a
              class="bio-link"
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span class="bio-link-label">{link.label}</span>
              <span class="bio-link-desc">{link.desc}</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H8M17 7v9" />
              </svg>
            </a>
          ))
        }
      </nav>

      <div class="bio-socials">
        {
          socials.map((social) => (
            <a
              class="bio-social"
              href={social.href}
              target="_blank"
              rel="noreferrer"
              aria-label={social.label}
            >
              {social.icon === 'github' && <Github size={20} />}
              {social.icon === 'linkedin' && <Linkedin size={20} />}
              {social.icon === 'threads' && (
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12.186 24h-.387c-3.734-.024-6.878-1.284-9.336-3.743C-.098 17.798-.328 11.402.078 7.345c.36-3.595 1.598-6.574 3.776-9.097C6.965 1.293 10.129 0 12.8 0c2.67 0 5.834 1.293 8.946 3.248 2.178 2.523 3.416 5.502 3.776 9.097.406 4.057.176 10.453-3.385 13.912C19.675 22.716 16.53 23.976 12.796 24h-.61ZM12.8 1.5c-2.3 0-5.094 1.13-7.766 3.018C2.95 6.895 1.836 9.61 1.5 13c-.387 3.866-.176 9.5 3.075 12.75C6.8 22.925 9.5 24 12.5 24h.387c3 0 5.7-1.075 7.925-3.25C23.663 22.5 23.874 16.866 23.487 13c-.336-3.39-1.45-6.105-3.534-8.482C17.28 2.63 14.486 1.5 12.186 1.5h-.387ZM12 18c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6Zm0-10.5c-2.485 0-4.5 2.015-4.5 4.5s2.015 4.5 4.5 4.5 4.5-2.015 4.5-4.5S14.485 7.5 12 7.5Z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </main>
  </body>
</html>

<style>
  .bio-page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-bg);
    color: var(--paper-ink);
    padding: 80px 20px;
  }

  .bio-main {
    width: min(100%, 480px);
  }

  .bio-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 40px;
  }

  .bio-header img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
    border: 2px solid var(--paper-line);
  }

  .bio-header h1 {
    margin: 0;
    color: var(--paper-ink);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .bio-role {
    margin: 6px 0 0;
    color: var(--paper-ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .bio-location {
    margin: 2px 0 0;
    color: var(--paper-ink-faint);
    font-size: 0.85rem;
  }

  .bio-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bio-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: var(--paper-surface);
    color: var(--paper-ink);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .bio-link:hover {
    border-color: var(--paper-ink);
    background: var(--paper-control);
    transform: translateY(-1px);
  }

  .bio-link-label {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .bio-link-desc {
    flex: 1;
    color: var(--paper-ink-faint);
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bio-link svg {
    flex: 0 0 auto;
    color: var(--paper-ink-faint);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .bio-link:hover svg {
    color: var(--paper-accent);
    transform: translateX(2px) translateY(-2px);
  }

  .bio-socials {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 32px;
  }

  .bio-social {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--paper-ink-soft);
    text-decoration: none;
    transition:
      color 180ms ease,
      background 180ms ease;
  }

  .bio-social:hover {
    color: var(--paper-accent);
    background: var(--paper-control);
  }
</style>
