---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import BlogTopNav from '../../components/blog/BlogTopNav.astro';
import { getSiteConfig } from '../../data/site';
import {
  formatRating,
  slugifyCategory,
  sortTools,
  toolPricingLabels,
  toolStatusLabels,
} from '../../utils/tools';

const { site, theme } = await getSiteConfig();
const palette = theme.palette;
const tools = sortTools(await getCollection('tools', ({ data }) => !data.draft));

const categories = [...new Set(tools.map((tool) => tool.data.category))]
  .sort((a, b) => a.localeCompare(b))
  .map((name) => ({
    name,
    slug: slugifyCategory(name),
    count: tools.filter((tool) => tool.data.category === name).length,
  }));

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

const pageDescription =
  'Tools I actually use, tried, or retired, with honest notes on what works and what does not.';
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <BaseHead title={`tools | ${site.title}`} description={pageDescription} />
    <style>
      main {
        width: min(100%, var(--layout-reading-width));
        padding: var(--layout-page-top) var(--layout-page-gutter) var(--layout-page-bottom);
      }

      .tools-hero {
        display: grid;
        gap: 12px;
        margin-bottom: 28px;
      }

      .tools-kicker,
      .tool-card-meta,
      .tools-empty span {
        color: var(--paper-ink-faint);
        font-family: var(--font-ui-label);
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        color: var(--paper-ink);
        font-size: clamp(2.35rem, 7vw, 4.4rem);
        font-weight: 400;
        letter-spacing: -0.06em;
        line-height: 0.95;
      }

      .tools-hero p,
      .tool-card p,
      .tools-empty p {
        margin: 0;
        color: var(--paper-ink-soft);
        line-height: 1.7;
      }

      .tools-hero p {
        max-width: 58ch;
      }

      .tools-filter {
        display: flex;
        gap: 8px;
        margin: 0 calc(var(--layout-page-gutter) * -1) 24px;
        padding: 2px var(--layout-page-gutter) 6px;
        overflow-x: auto;
        scrollbar-width: none;
        overscroll-behavior-x: contain;
      }

      .tools-filter::-webkit-scrollbar {
        display: none;
      }

      .tools-filter button {
        flex: 0 0 auto;
        min-height: 40px;
        padding: 0 14px;
        border: 1px solid var(--paper-line);
        border-radius: 999px;
        background: var(--paper-surface);
        color: var(--paper-ink-soft);
        font: inherit;
        font-family: var(--font-ui-label);
        font-size: 0.85rem;
        cursor: pointer;
        touch-action: manipulation;
        transition:
          border-color 180ms ease,
          background 180ms ease,
          color 180ms ease;
      }

      .tools-filter button small {
        margin-left: 4px;
        color: var(--paper-ink-faint);
        font-size: 0.75rem;
      }

      .tools-filter button[aria-pressed='true'] {
        border-color: var(--paper-ink);
        background: var(--paper-ink);
        color: var(--paper-bg);
      }

      .tools-filter button[aria-pressed='true'] small {
        color: inherit;
        opacity: 0.7;
      }

      .tools-filter button:focus-visible,
      .tool-card:focus-visible {
        outline: 2px solid var(--paper-accent);
        outline-offset: 2px;
      }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .tool-card,
      .tools-empty {
        border: 1px solid var(--paper-line);
        border-radius: 8px;
        background: var(--paper-surface);
        box-shadow: var(--paper-shadow);
      }

      .tool-card {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        gap: 10px;
        padding: 20px;
        color: var(--paper-ink);
        text-decoration: none;
        transition:
          transform 180ms ease,
          border-color 180ms ease,
          background 180ms ease;
      }

      .tool-card[hidden] {
        display: none;
      }

      .tool-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
      }

      .tool-card h2 {
        margin: 0;
        color: var(--paper-ink);
        font-size: 1.3rem;
        line-height: 1.25;
      }

      .tool-card-rating {
        flex: 0 0 auto;
        padding: 2px 10px;
        border-radius: 999px;
        background: var(--paper-control);
        color: var(--paper-ink);
        font-family: var(--font-ui-label);
        font-size: 0.85rem;
        font-weight: 700;
      }

      .tool-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .tool-card-tags small {
        padding: 3px 8px;
        border: 1px solid var(--paper-line);
        border-radius: 999px;
        color: var(--paper-ink-soft);
        font-family: var(--font-ui-label);
        font-size: 0.74rem;
      }

      .tool-card-tags .is-daily {
        border-color: var(--paper-accent);
        color: var(--paper-accent);
      }

      .tool-card-tags .is-retired {
        color: var(--paper-ink-faint);
      }

      .tools-empty {
        display: grid;
        gap: 10px;
        padding: 24px;
      }

      .tools-empty h2 {
        margin: 0;
        color: var(--paper-ink);
        font-size: 1.32rem;
      }

      @media (hover: hover) {
        .tool-card:hover {
          border-color: var(--paper-line-strong);
          background: var(--paper-control-hover);
          transform: translateY(-1px);
        }

        .tools-filter button:hover {
          border-color: var(--paper-ink);
          color: var(--paper-ink);
        }

        .tools-filter button[aria-pressed='true']:hover {
          color: var(--paper-bg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .tool-card,
        .tools-filter button {
          transition: none;
        }
      }

      @media (max-width: 720px) {
        main {
          padding-top: var(--layout-page-top-mobile);
        }

        .tools-grid {
          grid-template-columns: 1fr;
          gap: 12px;
        }

        .tool-card {
          padding: 18px 16px;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main id="main-content" data-pagefind-body>
      <header class="tools-hero">
        <p class="tools-kicker">Curated toolbox</p>
        <h1>Tools</h1>
        <p>{pageDescription}</p>
      </header>

      {
        tools.length > 0 ? (
          <>
            {categories.length > 1 && (
              <div
                class="tools-filter"
                role="group"
                aria-label="Filter tools by category"
                data-pagefind-ignore
              >
                <button type="button" data-filter="all" aria-pressed="true">
                  All<small>{tools.length}</small>
                </button>
                {categories.map((category) => (
                  <button type="button" data-filter={category.slug} aria-pressed="false">
                    {category.name}
                    <small>{category.count}</small>
                  </button>
                ))}
              </div>
            )}

            <section class="tools-grid" aria-label="Tools" aria-live="polite">
              {tools.map((tool) => (
                <a
                  class="tool-card"
                  href={withBase(`/tools/${tool.id}/`)}
                  data-category={slugifyCategory(tool.data.category)}
                >
                  <span class="tool-card-meta">{tool.data.category}</span>
                  <span class="tool-card-head">
                    <h2>{tool.data.title}</h2>
                    <span
                      class="tool-card-rating"
                      aria-label={`Rating ${formatRating(tool.data.rating)} out of 5`}
                    >
                      {formatRating(tool.data.rating)}
                    </span>
                  </span>
                  <p>{tool.data.verdict}</p>
                  <span class="tool-card-tags">
                    <small
                      class:list={{
                        'is-daily': tool.data.status === 'daily-driver',
                        'is-retired': tool.data.status === 'retired',
                      }}
                    >
                      {toolStatusLabels[tool.data.status]}
                    </small>
                    <small>{toolPricingLabels[tool.data.pricing]}</small>
                  </span>
                </a>
              ))}
            </section>
          </>
        ) : (
          <section class="tools-empty" aria-label="Tools empty state">
            <span aria-hidden="true">00</span>
            <h2>No tools yet.</h2>
            <p>
              Run <code>bun run tool:new my-tool</code> to add the first review.
            </p>
          </section>
        )
      }
    </main>
    <Footer />

    <script>
      function initToolsFilter() {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.tools-filter button');
        const cards = document.querySelectorAll<HTMLElement>('.tool-card');

        if (buttons.length === 0) return;

        const apply = (filter: string) => {
          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
          });
          cards.forEach((card) => {
            card.hidden = filter !== 'all' && card.dataset.category !== filter;
          });
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const filter = button.dataset.filter ?? 'all';
            apply(filter);
            const url = new URL(window.location.href);
            if (filter === 'all') url.searchParams.delete('category');
            else url.searchParams.set('category', filter);
            history.replaceState(null, '', url);
          });
        });

        const initial = new URL(window.location.href).searchParams.get('category');
        if (initial && [...buttons].some((button) => button.dataset.filter === initial)) {
          apply(initial);
        }
      }

      // ClientRouter fires astro:page-load on the initial load and after every navigation.
      document.addEventListener('astro:page-load', initToolsFilter);
    </script>
  </body>
</html>
